{
  "name": "smpn20-muarojambi",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
  // Domain kustom belum diisi -- begitu sudah ada domain (mis. dari
  // Cloudflare Registrar atau dipindah DNS-nya ke Cloudflare), tambahkan:
  // "routes": [{ "pattern": "smpn20muarojambi.sch.id", "custom_domain": true }]
  // Sebelum itu, situs tetap bisa diakses lewat subdomain gratis
  // *.workers.dev yang otomatis aktif selama workers_dev: true.
}
