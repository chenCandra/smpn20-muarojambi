---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import MobileMenu from './MobileMenu.astro';
import { school } from '../data/school';

const navItems = [
  { href: '/', label: 'Beranda' },
  { href: '/profil', label: 'Profil' },
  { href: '/akademik', label: 'Akademik' },
  { href: '/kegiatan', label: 'Kegiatan' },
  { href: '/berita', label: 'Berita' },
  { href: '/informasi', label: 'Informasi' },
  { href: '/kontak', label: 'Kontak' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<header
  data-navbar
  class="group sticky top-0 z-50 border-b border-transparent bg-white/70 backdrop-blur transition-all duration-300 [&.is-scrolled]:border-border [&.is-scrolled]:bg-white/95 [&.is-scrolled]:shadow-sm"
>
  <div class="container-page flex h-16 items-center justify-between transition-all duration-300 group-[.is-scrolled]:h-14">
    <a href="/" class="flex items-center gap-2.5">
      <Logo size={38} />
      <span class="flex flex-col leading-tight">
        <span class="text-sm font-extrabold text-ink">{school.shortCode}</span>
        <span class="text-[11px] font-medium text-ink-faint">Muaro Jambi</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Navigasi utama">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-lg px-3.5 py-2 text-sm font-semibold transition-colors',
            isActive(item.href) ? 'text-primary-dark' : 'text-ink-soft hover:text-primary-dark',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href="/informasi#ppdb" class="btn-accent hidden lg:inline-flex !px-4 !py-2 text-xs">
        <Icon name="graduation-cap" class="h-4 w-4" />
        Informasi PPDB
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Buka menu navigasi"
        class="flex h-10 w-10 items-center justify-center rounded-xl text-ink hover:bg-bg md:hidden"
      >
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </div>
</header>

<MobileMenu items={navItems} currentPath={currentPath} />
