---
import type { Teacher } from '../../lib/teachers';

interface Props {
  teacher?: Teacher | null;
  action: string;
  error?: string | null;
  nextSortOrder: number;
}

const { teacher = null, action, error = null, nextSortOrder } = Astro.props;
---

<form method="POST" action={action} class="mt-6 flex max-w-2xl flex-col gap-5">
  {error && <div class="rounded-xl bg-accent2-light px-4 py-2.5 text-sm font-semibold text-accent2-dark">{error}</div>}

  <div>
    <label for="name" class="text-sm font-semibold">Nama</label>
    <input
      id="name"
      name="name"
      type="text"
      required
      value={teacher?.name}
      class="mt-1.5 w-full rounded-xl border border-border px-4 py-2.5 text-sm outline-none focus:border-secondary"
    />
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="position" class="text-sm font-semibold">Jabatan</label>
      <input
        id="position"
        name="position"
        type="text"
        required
        placeholder="mis. Guru, Kepala Sekolah, Wakasek Kurikulum"
        value={teacher?.position}
        class="mt-1.5 w-full rounded-xl border border-border px-4 py-2.5 text-sm outline-none focus:border-secondary"
      />
    </div>
    <div>
      <label for="subject" class="text-sm font-semibold">Mata Pelajaran <span class="font-normal text-ink-faint">(opsional)</span></label>
      <input
        id="subject"
        name="subject"
        type="text"
        value={teacher?.subject ?? ''}
        class="mt-1.5 w-full rounded-xl border border-border px-4 py-2.5 text-sm outline-none focus:border-secondary"
      />
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="photo" class="text-sm font-semibold">URL Foto <span class="font-normal text-ink-faint">(opsional)</span></label>
      <input
        id="photo"
        name="photo"
        type="text"
        value={teacher?.photo ?? ''}
        placeholder="/images/teachers/nama-file.jpg"
        class="mt-1.5 w-full rounded-xl border border-border px-4 py-2.5 text-sm outline-none focus:border-secondary"
      />
    </div>
    <div>
      <label for="sort_order" class="text-sm font-semibold">Urutan Tampil</label>
      <input
        id="sort_order"
        name="sort_order"
        type="number"
        value={teacher?.sort_order ?? nextSortOrder}
        class="mt-1.5 w-full rounded-xl border border-border px-4 py-2.5 text-sm outline-none focus:border-secondary"
      />
    </div>
  </div>

  <div class="flex gap-3">
    <button type="submit" class="btn-primary">Simpan</button>
    <a href="/admin/teachers" class="btn-outline">Batal</a>
  </div>
</form>
