---
// Aksen dekoratif tema space/sains (roket, bintang, orbit) -- dipakai di
// Hero & CTASection. Murni dekorasi (aria-hidden), animasi CSS ringan
// (float/spin-slow/twinkle, didefinisikan di global.css @theme), otomatis
// nonaktif untuk prefers-reduced-motion. Porsi elemen SENGAJA dibatasi
// (butir 27: "less decoration, more personality") -- jangan tambah lebih
// banyak tanpa alasan.
import Icon from './Icon.astro';

interface Props {
  variant?: 'hero' | 'cta';
}

const { variant = 'hero' } = Astro.props;
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <Icon
    name="rocket"
    class={`absolute ${variant === 'hero' ? 'right-[8%] top-[14%] w-10 h-10 sm:w-14 sm:h-14' : 'right-[10%] top-[20%] w-9 h-9'} text-accent2 animate-float rotate-[35deg]`}
  />
  <Icon name="star" class="absolute left-[6%] top-[22%] w-5 h-5 text-accent animate-twinkle" />
  <Icon name="star" class="absolute right-[20%] top-[65%] w-4 h-4 text-white/80 animate-twinkle [animation-delay:1s]" />
  <Icon name="star" class="absolute left-[16%] bottom-[18%] w-3 h-3 text-accent animate-twinkle [animation-delay:0.5s]" />
  <span class="absolute left-[80%] bottom-[24%] h-2 w-2 rounded-full bg-white/70 animate-float-slow"></span>
  <span class="absolute left-[30%] top-[12%] h-1.5 w-1.5 rounded-full bg-accent/80 animate-float"></span>
  <Icon name="orbit" class="absolute left-[4%] bottom-[8%] w-16 h-16 text-white/20 animate-spin-slow" />
</div>
