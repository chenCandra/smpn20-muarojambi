---
// Maskot kartun kecil -- karakter bulat pakai topi wisuda, melambai. Murni
// SVG buatan tangan (bukan file gambar) supaya ringan & gampang diganti
// warnanya lewat CSS var, plus dianimasikan CSS-only (bob + lambaian
// tangan) tanpa JS sama sekali.
interface Props {
  size?: number;
  class?: string;
}

const { size = 200, class: className = '' } = Astro.props;
---

<div class:list={['mascot', className]} style={`width:${size}px`}>
  <svg viewBox="0 0 220 240" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Maskot sekolah melambai">
    <!-- bayangan -->
    <ellipse cx="110" cy="228" rx="52" ry="9" fill="#0f5132" opacity="0.12" />

    <g class="mascot-bob">
      <!-- lengan kiri (statis, agak ke belakang badan) -->
      <ellipse cx="52" cy="145" rx="15" ry="32" fill="#ff8a3d" transform="rotate(18 52 145)" />

      <!-- badan -->
      <ellipse cx="110" cy="150" rx="68" ry="72" fill="#ff8a3d" />
      <ellipse cx="110" cy="150" rx="68" ry="72" fill="url(#mascotShade)" opacity="0.5" />

      <!-- pipi -->
      <circle cx="76" cy="158" r="11" fill="#ff6f91" opacity="0.55" />
      <circle cx="144" cy="158" r="11" fill="#ff6f91" opacity="0.55" />

      <!-- mata -->
      <ellipse cx="89" cy="138" rx="9" ry="12" fill="#1c2620" />
      <ellipse cx="131" cy="138" rx="9" ry="12" fill="#1c2620" />
      <circle cx="92" cy="133" r="3" fill="#fff" />
      <circle cx="134" cy="133" r="3" fill="#fff" />

      <!-- senyum -->
      <path d="M88 163 Q110 182 132 163" stroke="#1c2620" stroke-width="5" fill="none" stroke-linecap="round" />

      <!-- topi wisuda -->
      <g transform="translate(110 78)">
        <polygon points="-56,8 0,-18 56,8 0,32" fill="#0f5132" />
        <rect x="-9" y="6" width="18" height="12" rx="2" fill="#0f5132" />
        <circle cx="0" cy="-18" r="5" fill="#ffce54" />
        <line x1="0" y1="-18" x2="30" y2="16" stroke="#ffce54" stroke-width="3" stroke-linecap="round" />
        <circle cx="30" cy="20" r="5" fill="#ffce54" />
      </g>

      <!-- lengan kanan melambai -- ellipse diposisikan LANGSUNG lewat cx/cy
           (bukan lewat CSS transform:translate), karena animasi CSS di
           bawah menimpa (bukan menambah) properti `transform` tiap frame.
           transform-origin dipasang persis di titik bahu (ujung atas
           elipsnya) supaya yang berayun itu "tangan"-nya, bukan berputar
           di tengah badan lengan. -->
      <ellipse class="mascot-wave" cx="172" cy="150" rx="14" ry="32" fill="#ff8a3d" />
    </g>

    <defs>
      <linearGradient id="mascotShade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.25" />
        <stop offset="100%" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
    </defs>
  </svg>
</div>

<style>
  .mascot {
    max-width: 100%;
  }

  .mascot svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .mascot-bob {
    animation: bob 3.2s ease-in-out infinite;
  }

  .mascot-wave {
    transform-box: view-box;
    transform-origin: 172px 118px; /* titik bahu -- ujung atas elips lengan */
    animation: mascot-wave-arm 2.4s ease-in-out infinite;
    animation-delay: 0.6s;
  }

  /* Nama beda sendiri (bukan pakai @keyframes wave-arm yang di global.css)
     -- @keyframes itu identifier GLOBAL, tidak ikut di-scope Astro seperti
     selector class biasa, jadi harus unik biar nggak numpuk/nimpa definisi
     lain yang kebetulan pakai nama sama. */
  @keyframes mascot-wave-arm {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(35deg); }
    50% { transform: rotate(5deg); }
    75% { transform: rotate(35deg); }
  }
</style>
