---
import type { Teacher } from '../lib/teachers';

interface Props {
  teacher: Teacher;
  delay?: number;
}

const { teacher, delay = 0 } = Astro.props;
const initial = teacher.name.replace('[', '').charAt(0);
---

<div class="reveal card flex flex-col items-center p-5 text-center" style={`animation-delay:${delay}ms`}>
  {teacher.photo ? (
    <img src={teacher.photo} alt={teacher.name} loading="lazy" class="h-20 w-20 rounded-full object-cover" />
  ) : (
    <div class="flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br from-primary-light to-secondary-light text-xl font-extrabold text-primary-dark">
      {initial}
    </div>
  )}
  <h3 class="mt-3 text-sm font-bold">{teacher.name}</h3>
  <p class="text-xs font-semibold text-secondary">{teacher.position}</p>
  {teacher.subject && <p class="text-xs text-ink-faint">{teacher.subject}</p>}
</div>
