---
import Icon from './Icon.astro';
import DecorativeSpace from './DecorativeSpace.astro';
---

<section class="relative overflow-hidden bg-gradient-to-br from-secondary to-primary-dark py-16 sm:py-20">
  <DecorativeSpace variant="cta" />
  <div class="container-page reveal relative text-center">
    <h2 class="text-3xl text-white sm:text-4xl">Siap Menjelajahi Masa Depan?</h2>
    <p class="mx-auto mt-3 max-w-lg text-base text-white/85 sm:text-lg">Kenali lebih dekat SMPN 20 Muaro Jambi.</p>
    <a href="/profil" class="btn-accent mt-7 inline-flex">
      Jelajahi Sekolah
      <Icon name="rocket" class="h-4 w-4" />
    </a>
  </div>
</section>
