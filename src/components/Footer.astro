---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-grid">
    <div>
      <strong class="footer-brand">SMP Negeri 20 Muaro Jambi</strong>
      <p class="footer-address">
        Kabupaten Muaro Jambi, Provinsi Jambi<br>
        Email: info@smpn20muarojambi.sch.id
      </p>
    </div>
    <div>
      <strong>Tautan</strong>
      <ul class="footer-links">
        <li><a href="/profil">Profil Sekolah</a></li>
        <li><a href="/ppdb">Penerimaan Siswa Baru</a></li>
        <li><a href="/berita">Berita</a></li>
        <li><a href="/kontak">Kontak</a></li>
      </ul>
    </div>
    <div>
      <strong>Informasi</strong>
      <ul class="footer-links">
        <li><a href="/agenda">Agenda</a></li>
        <li><a href="/prestasi">Prestasi</a></li>
        <li><a href="/pengumuman">Pengumuman</a></li>
        <li><a href="/galeri">Galeri</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>&copy; {year} SMP Negeri 20 Muaro Jambi. Hak cipta dilindungi.</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--primary-dark);
    color: #dfe9e3;
    padding-block: 3rem 1.5rem;
    margin-top: 4rem;
  }

  .footer-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .footer-brand {
    font-family: var(--font-display);
    color: #fff;
    display: block;
    margin-bottom: 0.5rem;
  }

  .footer-address {
    color: #b9cabf;
    font-size: 0.875rem;
    margin: 0;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-links a {
    color: #cfe0d7;
    text-decoration: none;
    font-size: 0.875rem;
  }

  .footer-links a:hover {
    color: #fff;
  }

  .footer-bottom {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.8125rem;
    color: #a8bcb0;
  }
</style>
