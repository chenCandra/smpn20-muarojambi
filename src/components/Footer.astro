---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { school } from '../data/school';

const year = new Date().getFullYear();

const menu = [
  { href: '/profil', label: 'Profil' },
  { href: '/akademik', label: 'Akademik' },
  { href: '/kegiatan', label: 'Kegiatan' },
  { href: '/berita', label: 'Berita' },
  { href: '/informasi', label: 'Informasi' },
  { href: '/kontak', label: 'Kontak' },
];

const socialLinks = [
  { key: 'instagram', href: school.social.instagram },
  { key: 'facebook', href: school.social.facebook },
  { key: 'youtube', href: school.social.youtube },
  { key: 'tiktok', href: school.social.tiktok },
].filter((s) => s.href);
---

<footer class="bg-ink text-slate-300">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <a href="/" class="flex items-center gap-2.5">
        <Logo size={38} />
        <span class="flex flex-col leading-tight">
          <span class="text-sm font-extrabold text-white">{school.fullName}</span>
          <span class="text-xs font-medium text-secondary-light/80">{school.tagline}</span>
        </span>
      </a>
      <p class="mt-4 max-w-sm text-sm text-slate-400">
        Sekolah tempat siswa belajar, berkarya, menemukan potensi, dan mempersiapkan diri untuk masa depan.
      </p>
      {socialLinks.length > 0 && (
        <div class="mt-5 flex gap-2">
          {socialLinks.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.key}
              class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-primary"
            >
              <Icon name={s.key} class="h-4 w-4" />
            </a>
          ))}
        </div>
      )}
    </div>

    <div>
      <h3 class="text-sm font-bold uppercase tracking-wide text-white">Informasi Kontak</h3>
      <ul class="mt-4 space-y-3 text-sm">
        <li class="flex gap-2.5"><Icon name="map-pin" class="h-4 w-4 shrink-0 text-primary" /><span>{school.address}, {school.city}, {school.province}</span></li>
        <li class="flex gap-2.5"><Icon name="phone" class="h-4 w-4 shrink-0 text-primary" /><span>{school.phone}</span></li>
        <li class="flex gap-2.5"><Icon name="mail" class="h-4 w-4 shrink-0 text-primary" /><span>{school.email}</span></li>
        <li class="flex gap-2.5"><Icon name="external-link" class="h-4 w-4 shrink-0 text-primary" /><span>{school.website.replace('https://', '')}</span></li>
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-bold uppercase tracking-wide text-white">Menu</h3>
      <ul class="mt-4 space-y-3 text-sm">
        {menu.map((item) => (
          <li><a href={item.href} class="transition-colors hover:text-white">{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col items-center justify-between gap-2 py-5 text-xs text-slate-500 sm:flex-row">
      <span>&copy; {year} {school.fullName}. Hak cipta dilindungi.</span>
      <span>{school.tagline}</span>
    </div>
  </div>
</footer>
