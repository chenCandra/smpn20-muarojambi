interface Props {
  name: keyof typeof ICONS | string;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = 'w-6 h-6', strokeWidth = 2 } = Astro.props;
const paths = ICONS[name] ?? ICONS.sparkle;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths}
/>
