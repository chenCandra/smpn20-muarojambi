---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, subtitle, align = 'left' } = Astro.props;
---

<div class:list={['reveal max-w-2xl', { 'mx-auto text-center': align === 'center' }]}>
  {eyebrow && (
    <span class="badge bg-secondary-light text-secondary mb-3">{eyebrow}</span>
  )}
  <h2 class="text-2xl sm:text-3xl md:text-4xl">{title}</h2>
  {subtitle && <p class="mt-3 text-base sm:text-lg text-ink-soft">{subtitle}</p>}
</div>
