---
import Icon from './Icon.astro';
import type { GalleryPhoto } from '../data/gallery';

interface Props {
  photos: GalleryPhoto[];
}

const { photos } = Astro.props;

// Masonry ringan pakai CSS multi-column (bukan grid seragam & bukan
// library JS) -- tiap foto dikasih aspect-ratio beda sesuai `size` biar
// tingginya bervariasi secara alami.
const aspectClass: Record<GalleryPhoto['size'], string> = {
  landscape: 'aspect-[4/3]',
  portrait: 'aspect-[3/4]',
  square: 'aspect-square',
};
---

<div class="columns-2 gap-4 sm:columns-3 [&>*]:mb-4">
  {photos.map((photo, i) => (
    <figure class="reveal group relative break-inside-avoid overflow-hidden rounded-[var(--radius-card)] bg-gradient-to-br from-primary-light to-secondary-light" style={`animation-delay:${i * 60}ms`}>
      <div class={aspectClass[photo.size]}>
        {photo.src ? (
          <img
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center text-primary-dark/40">
            <Icon name="file" class="h-8 w-8" />
          </div>
        )}
      </div>
      {photo.caption && (
        <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 translate-y-2 bg-gradient-to-t from-ink/80 to-transparent px-3 pb-2.5 pt-8 text-xs font-semibold text-white opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
          {photo.caption}
        </figcaption>
      )}
    </figure>
  ))}
</div>
