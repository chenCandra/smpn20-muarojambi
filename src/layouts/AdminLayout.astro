---
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import type { SessionUser } from '../lib/session';

interface Props {
  title: string;
  user: SessionUser;
}

const { title, user } = Astro.props;
const currentPath = Astro.url.pathname;
const currentCategory = Astro.url.searchParams.get('category');

const navItems = [
  { href: '/admin/posts', label: 'Berita & Info', icon: 'file' },
  { href: '/admin/posts?category=Pengumuman', label: 'Pengumuman', icon: 'megaphone' },
  { href: '/admin/ppdb', label: 'PPDB', icon: 'check' },
  { href: '/admin/teachers', label: 'Guru & Tendik', icon: 'graduation-cap' },
  { href: '/admin/stats', label: 'Statistik', icon: 'bar-chart' },
];

// "Berita & Info" & "Pengumuman" sama-sama menuju /admin/posts (dibedakan
// query ?category=) -- exact-match query biar cuma satu yang aktif
// sekaligus, bukan dua-duanya nyala bareng.
function isNavActive(href: string): boolean {
  const [hrefPath, hrefQuery] = href.split('?');
  if (!currentPath.startsWith(hrefPath)) return false;
  const hrefCategory = hrefQuery ? new URLSearchParams(hrefQuery).get('category') : null;
  return currentCategory === hrefCategory;
}
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Admin SMPN 20</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-bg text-ink">
    <div class="flex min-h-screen flex-col md:flex-row">
      <aside class="flex shrink-0 flex-col justify-between border-b border-border bg-white p-4 md:h-screen md:w-60 md:border-b-0 md:border-r md:sticky md:top-0">
        <div>
          <a href="/admin/posts" class="flex items-center gap-2.5 px-2 py-1.5">
            <Logo size={34} />
            <span class="text-sm font-extrabold">Admin SMPN 20</span>
          </a>
          <nav class="mt-6 flex flex-col gap-1" aria-label="Navigasi admin">
            {navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'flex items-center gap-2.5 rounded-xl px-3 py-2.5 text-sm font-semibold transition-colors',
                  isNavActive(item.href) ? 'bg-primary-light text-primary-dark' : 'text-ink-soft hover:bg-bg',
                ]}
              >
                <Icon name={item.icon} class="h-4.5 w-4.5" />
                {item.label}
              </a>
            ))}
            <a href="/" target="_blank" class="mt-2 flex items-center gap-2.5 rounded-xl px-3 py-2.5 text-sm font-semibold text-ink-soft hover:bg-bg">
              <Icon name="external-link" class="h-4.5 w-4.5" />
              Lihat Situs
            </a>
          </nav>
        </div>

        <div class="border-t border-border pt-4">
          <p class="px-2 text-sm font-bold">{user.name}</p>
          <p class="px-2 text-xs text-ink-faint">@{user.username}</p>
          <form method="POST" action="/admin/logout" class="mt-2">
            <button type="submit" class="flex w-full items-center gap-2.5 rounded-xl px-3 py-2.5 text-sm font-semibold text-ink-soft hover:bg-bg">
              <Icon name="x" class="h-4.5 w-4.5" />
              Keluar
            </button>
          </form>
        </div>
      </aside>

      <main class="flex-1 p-5 sm:p-8">
        <slot />
      </main>
    </div>
  </body>
</html>
