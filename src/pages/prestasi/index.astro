---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const semuaPrestasi = await getCollection('prestasi', ({ data }) => !data.draft);
const prestasi = semuaPrestasi.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const levelBadge: Record<string, string> = {
  Sekolah: 'level-sekolah',
  Kecamatan: 'level-kecamatan',
  Kabupaten: 'level-kabupaten',
  Provinsi: 'level-provinsi',
  Nasional: 'level-nasional',
  Internasional: 'level-internasional',
};
---

<BaseLayout title="Prestasi" description="Prestasi dan pencapaian siswa SMP Negeri 20 Muaro Jambi.">
  <PageHeader eyebrow="🏆 Kebanggaan" title="Prestasi" />

  <section class="section">
    <div class="container">
      {prestasi.length === 0 ? (
        <p class="empty-note">Belum ada prestasi yang ditambahkan.</p>
      ) : (
        <div class="grid grid-3">
          {prestasi.map((item) => (
            <a href={`/prestasi/${item.id}`} class="card prestasi-card">
              <span class:list={['level-badge', levelBadge[item.data.level]]}>{item.data.level} &middot; {item.data.year}</span>
              <h2>{item.data.title}</h2>
              {item.data.studentName && <p class="student-name">{item.data.studentName}</p>}
              {item.data.excerpt && <p>{item.data.excerpt}</p>}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .prestasi-card {
    display: block;
    padding: 1.25rem;
    text-decoration: none;
    color: var(--ink);
    height: 100%;
  }

  .level-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.6rem;
  }

  .level-sekolah { background: var(--surface-alt); color: var(--ink-soft); }
  .level-kecamatan { background: var(--accent-soft); color: var(--accent); }
  .level-kabupaten { background: var(--primary-soft); color: var(--primary); }
  .level-provinsi { background: var(--accent2-soft); color: var(--accent2); }
  .level-nasional { background: var(--accent3-soft); color: var(--accent3); }
  .level-internasional { background: var(--primary-dark); color: #fff; }

  .prestasi-card h2 {
    font-size: 1.0625rem;
    margin: 0 0 0.3rem;
  }

  .student-name {
    font-size: 0.875rem;
    color: var(--primary);
    font-weight: 600;
    margin: 0 0 0.3rem;
  }

  .prestasi-card p:not(.student-name) {
    font-size: 0.9375rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .empty-note {
    color: var(--ink-soft);
  }
</style>
