---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mascot from '../components/Mascot.astro';
import FloatingShapes from '../components/FloatingShapes.astro';
import { getCollection } from 'astro:content';

const semuaBerita = await getCollection('berita', ({ data }) => !data.draft);
const beritaTerbaru = semuaBerita.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const formatTanggal = (d: Date) => d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });

const highlights = [
  { emoji: '📚', title: 'Kurikulum Merdeka', text: 'Pembelajaran yang berpusat pada peserta didik, mendorong minat dan potensi setiap siswa.' },
  { emoji: '🎨', title: 'Ekstrakurikuler', text: 'Beragam kegiatan pengembangan bakat non-akademik untuk menunjang tumbuh kembang siswa.' },
  { emoji: '🌟', title: 'Guru Berkualitas', text: 'Tenaga pendidik profesional yang berkomitmen mendampingi proses belajar siswa.' },
];
---

<BaseLayout title="Beranda">
  <section class="hero">
    <FloatingShapes />
    <div class="container hero-inner">
      <div class="hero-text">
        <span class="eyebrow">👋 Selamat Datang</span>
        <h1>SMP Negeri 20 Muaro Jambi</h1>
        <p class="hero-lede">
          Sekolah seru buat belajar, berkarya, dan berteman! Kami mewujudkan generasi yang berakhlak mulia,
          cerdas, dan berdaya saing di Kabupaten Muaro Jambi.
        </p>
        <div class="hero-actions">
          <a href="/ppdb" class="btn btn-primary">Info PPDB</a>
          <a href="/profil" class="btn btn-outline">Profil Sekolah</a>
        </div>
      </div>
      <div class="hero-mascot">
        <Mascot size={220} />
      </div>
    </div>

    <svg class="hero-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,32 C240,80 480,0 720,24 C960,48 1200,72 1440,24 L1440,80 L0,80 Z" fill="var(--surface)" />
    </svg>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">📰 Berita</span>
          <h2>Kabar Terbaru</h2>
        </div>
        <a href="/berita" class="btn btn-outline">Semua Berita</a>
      </div>

      {beritaTerbaru.length === 0 ? (
        <p class="empty-note">Belum ada berita yang diterbitkan.</p>
      ) : (
        <div class="grid grid-3">
          {beritaTerbaru.map((post) => (
            <a href={`/berita/${post.id}`} class="card news-card">
              <span class="news-date">{formatTanggal(post.data.pubDate)}</span>
              <h3>{post.data.title}</h3>
              {post.data.excerpt && <p>{post.data.excerpt}</p>}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section section-alt">
    <div class="container grid grid-3 highlight-grid">
      {highlights.map((item) => (
        <div class="card highlight-card">
          <span class="highlight-emoji">{item.emoji}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    background: linear-gradient(160deg, var(--primary) 0%, var(--primary-dark) 100%);
    color: #fff;
    padding-block: 4rem 5.5rem;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .hero-text {
    max-width: 34rem;
    flex: 1 1 20rem;
  }

  .hero h1 {
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    color: #fff;
  }

  .hero-lede {
    color: #dcebe3;
    font-size: 1.0625rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .hero .btn-outline {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.6);
  }

  .hero .btn-outline:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .hero-mascot {
    flex: 0 0 auto;
    filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.2));
  }

  @media (max-width: 640px) {
    .hero-mascot {
      width: 9rem;
      margin-inline: auto;
    }
  }

  .hero-wave {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: 48px;
    display: block;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .section-head h2 {
    margin: 0;
  }

  .news-card {
    display: block;
    padding: 1.25rem;
    text-decoration: none;
    color: var(--ink);
    height: 100%;
  }

  .news-date {
    font-size: 0.8125rem;
    color: var(--ink-faint);
  }

  .news-card h3 {
    font-size: 1.0625rem;
    margin: 0.4rem 0 0.4rem;
  }

  .news-card p {
    font-size: 0.9375rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .empty-note {
    color: var(--ink-soft);
  }

  .highlight-card {
    padding: 1.5rem;
    text-align: center;
  }

  .highlight-emoji {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--accent-soft);
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .highlight-card:nth-child(2) .highlight-emoji {
    background: var(--accent2-soft);
  }

  .highlight-card:nth-child(3) .highlight-emoji {
    background: var(--accent3-soft);
  }

  .highlight-card h3 {
    color: var(--primary);
    font-size: 1.0625rem;
  }

  .highlight-card p {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    margin: 0;
  }
</style>
