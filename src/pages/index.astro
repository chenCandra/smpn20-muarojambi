---
// Beranda campur konten statis & dinamis (Berita dari D1) -- karena
// Astro nggak bisa "prerender sebagian halaman", satu section dinamis
// bikin SELURUH halaman ini SSR (bukan cuma cache-bust bagian berita-nya).
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureCard from '../components/FeatureCard.astro';
import StatCard from '../components/StatCard.astro';
import NewsCard from '../components/NewsCard.astro';
import EventTimeline from '../components/EventTimeline.astro';
import ExtracurricularCard from '../components/ExtracurricularCard.astro';
import TeacherCard from '../components/TeacherCard.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import ParentInfoCard from '../components/ParentInfoCard.astro';
import CTASection from '../components/CTASection.astro';
import Icon from '../components/Icon.astro';

import { stats } from '../data/school';
import { getPublishedPosts } from '../lib/posts';
import { env } from '../lib/env';
import { events } from '../data/events';
import { extracurriculars } from '../data/extracurriculars';
import { teachers } from '../data/teachers';
import { gallery } from '../data/gallery';
import { fields } from '../data/fields';

const db = env.DB;
const beritaTerbaru = await getPublishedPosts(db, { limit: 3 });
const agendaMendatang = [...events]
  .filter((e) => new Date(e.date) >= new Date(new Date().toDateString()))
  .sort((a, b) => new Date(a.date).valueOf() - new Date(b.date).valueOf())
  .slice(0, 3);
const guruPreview = teachers.slice(0, 4);

const parentInfo = [
  { icon: 'megaphone', title: 'Pengumuman', description: 'Info terbaru untuk siswa & orang tua.', href: '/informasi#pengumuman' },
  { icon: 'calendar', title: 'Kalender Akademik', description: 'Jadwal kegiatan sekolah satu tahun ajaran.', href: '/akademik' },
  { icon: 'download', title: 'Download Dokumen', description: 'Formulir dan dokumen penting sekolah.', href: '/informasi#dokumen' },
  { icon: 'book-open', title: 'Informasi Akademik', description: 'Kurikulum dan sistem pembelajaran.', href: '/akademik' },
  { icon: 'graduation-cap', title: 'PPDB', description: 'Penerimaan Peserta Didik Baru.', href: '/informasi#ppdb' },
  { icon: 'phone', title: 'Kontak Sekolah', description: 'Hubungi kami untuk informasi lebih lanjut.', href: '/kontak' },
];
---

<BaseLayout title="Beranda">
  <Hero />

  <!-- Intro Sekolah -->
  <section class="py-16 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Tentang Kami" title="Hai! 👋 Kami SMPN 20 Muaro Jambi" />
      <p class="reveal mt-4 max-w-2xl text-base text-ink-soft [animation-delay:80ms]">
        SMPN 20 Muaro Jambi hadir sebagai ruang belajar tempat siswa tidak hanya belajar dari buku, tetapi juga
        mencoba hal baru, berkolaborasi, berkarya, dan tumbuh menjadi pribadi yang percaya diri.
      </p>
      <div class="mt-10 grid gap-5 sm:grid-cols-3">
        <FeatureCard icon="book-open" title="Belajar" description="Pembelajaran aktif dan bermakna." tone="primary" />
        <FeatureCard icon="lightbulb" title="Berkarya" description="Ruang untuk kreativitas dan inovasi." tone="secondary" delay={80} />
        <FeatureCard icon="sprout" title="Bertumbuh" description="Membangun karakter dan mempersiapkan masa depan." tone="accent" delay={160} />
      </div>
    </div>
  </section>

  <!-- Statistics -->
  <section class="bg-gradient-to-br from-secondary to-primary-dark py-14 sm:py-16">
    <div class="container-page grid grid-cols-2 gap-8 sm:grid-cols-4">
      {stats.map((s) => <StatCard value={s.value} suffix={s.suffix} label={s.label} />)}
    </div>
  </section>

  <!-- Explore Your Universe -->
  <section class="bg-secondary-light/40 py-16 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Minat & Bakat" title="Explore Your Universe 🚀" subtitle="Setiap siswa punya minat, bakat, dan cerita yang berbeda." align="center" />
      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        {fields.map((f, i) => (
          <div class="reveal group card flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 hover:-translate-y-1.5 hover:shadow-lg" style={`animation-delay:${i * 60}ms`}>
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary-light text-primary-dark transition-transform duration-300 group-hover:scale-110">
              <Icon name={f.icon} class="h-6 w-6" />
            </div>
            <h3 class="text-xs font-bold leading-tight">{f.name}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Berita -->
  <section class="py-16 sm:py-20">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading eyebrow="Info Sekolah" title="Stories from SMPN 20 📰" />
        <a href="/berita" class="btn-outline shrink-0">Lihat Semua Berita <Icon name="arrow-right" class="h-4 w-4" /></a>
      </div>
      {beritaTerbaru.length === 0 ? (
        <p class="mt-10 text-sm text-ink-soft">Belum ada berita yang diterbitkan.</p>
      ) : (
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {beritaTerbaru.map((a) => <NewsCard article={a} />)}
        </div>
      )}
    </div>
  </section>

  <!-- Agenda -->
  <section class="bg-bg py-16 sm:py-20">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:items-start">
      <div>
        <SectionHeading eyebrow="Kalender" title="What's Happening? 🎉" subtitle="Ikuti terus agenda dan kegiatan sekolah kami." />
        <a href="/kegiatan" class="btn-outline mt-6">Lihat Semua Agenda <Icon name="arrow-right" class="h-4 w-4" /></a>
      </div>
      <EventTimeline events={agendaMendatang} />
    </div>
  </section>

  <!-- Ekstrakurikuler -->
  <section class="py-16 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Kegiatan Siswa" title="Find Your Passion ✨" subtitle="Temukan kegiatan yang membuatmu bersemangat." align="center" />
      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {extracurriculars.map((e, i) => <ExtracurricularCard name={e.name} icon={e.icon} description={e.description} delay={i * 50} />)}
      </div>
    </div>
  </section>

  <!-- Guru -->
  <section class="bg-secondary-light/40 py-16 sm:py-20">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading eyebrow="Tim Pendidik" title="Meet Our Teachers 👋" />
        <a href="/profil#guru" class="btn-outline shrink-0">Lihat Semua Guru <Icon name="arrow-right" class="h-4 w-4" /></a>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {guruPreview.map((t, i) => <TeacherCard teacher={t} delay={i * 60} />)}
      </div>
    </div>
  </section>

  <!-- Galeri -->
  <section class="py-16 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Dokumentasi" title="Moments at SMPN 20 📸" align="center" />
      <div class="mt-10">
        <GalleryGrid photos={gallery} />
      </div>
    </div>
  </section>

  <!-- Informasi Penting (untuk orang tua) -->
  <section class="bg-bg py-16 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Untuk Orang Tua & Wali" title="Informasi Penting" subtitle="Akses cepat ke informasi yang sering dicari." />
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {parentInfo.map((p, i) => <ParentInfoCard icon={p.icon} title={p.title} description={p.description} href={p.href} delay={i * 50} />)}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
