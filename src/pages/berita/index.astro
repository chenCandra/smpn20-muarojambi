---
// Sebelumnya baca src/data/news.ts (statis) -- sekarang baca dari D1
// (tabel `posts`, diisi lewat /admin), jadi WAJIB prerender=false biar
// datanya query ulang tiap request, bukan dibekukan di waktu build.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getPublishedPosts } from '../../lib/posts';
import type { PostCategory } from '../../lib/posts';
import { school } from '../../data/school';
import { env } from '../../lib/env';

const db = env.DB;
const kategoriList: PostCategory[] = ['Prestasi', 'Akademik', 'Kegiatan', 'Pengumuman', 'Sekolah'];
const artikel = await getPublishedPosts(db);
---

<BaseLayout title="Berita" description={`Berita dan kabar terbaru ${school.fullName}.`}>
  <section class="bg-gradient-to-br from-primary-light/70 to-secondary-light/60 pb-16 pt-16 sm:pt-20">
    <div class="container-page reveal">
      <span class="badge bg-white text-primary-dark shadow-sm">Info Sekolah</span>
      <h1 class="mt-4 text-3xl sm:text-4xl">Cerita dari SMPN 20 📰</h1>
      <p class="mt-3 max-w-xl text-ink-soft">Kumpulan berita, kegiatan, dan pengumuman terbaru seputar sekolah.</p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page">
      <!-- Filter kategori client-side (JS), bukan query-param server --
           lihat catatan di skrip bawah. -->
      <div id="filterBar" class="reveal flex flex-wrap gap-2">
        <button type="button" data-filter="Semua" class="badge is-active bg-secondary text-white transition-colors">Semua</button>
        {kategoriList.map((k) => (
          <button type="button" data-filter={k} class="badge border border-border bg-white text-ink-soft transition-colors hover:border-secondary/40">{k}</button>
        ))}
      </div>

      {artikel.length === 0 ? (
        <p class="mt-10 text-sm text-ink-soft">Belum ada berita yang diterbitkan. Tulis lewat <a href="/admin/posts" class="font-semibold text-secondary">panel admin</a>.</p>
      ) : (
        <div id="newsGrid" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {artikel.map((a) => (
            <div data-category={a.category}>
              <NewsCard article={a} />
            </div>
          ))}
        </div>
      )}
      <p id="emptyNote" class="mt-10 hidden text-sm text-ink-soft">Belum ada berita pada kategori ini.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#filterBar [data-filter]');
  const items = document.querySelectorAll<HTMLElement>('#newsGrid [data-category]');
  const emptyNote = document.getElementById('emptyNote');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        b.classList.remove('is-active', 'bg-secondary', 'text-white');
        b.classList.add('border', 'border-border', 'bg-white', 'text-ink-soft');
      });
      btn.classList.add('is-active', 'bg-secondary', 'text-white');
      btn.classList.remove('border', 'border-border', 'bg-white', 'text-ink-soft');

      const filter = btn.dataset.filter;
      let visibleCount = 0;
      items.forEach((item) => {
        const match = filter === 'Semua' || item.dataset.category === filter;
        item.style.display = match ? '' : 'none';
        if (match) visibleCount++;
      });
      emptyNote?.classList.toggle('hidden', visibleCount > 0);
    });
  });
</script>
