---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const semuaBerita = await getCollection('berita', ({ data }) => !data.draft);

  return semuaBerita.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatTanggal = (d: Date) => d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <article class="section">
    <div class="container article-container">
      <a href="/berita" class="back-link">&larr; Semua Berita</a>
      <span class="article-date">{formatTanggal(post.data.pubDate)}</span>
      <h1>{post.data.title}</h1>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-container {
    max-width: 42rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .article-date {
    display: block;
    font-size: 0.875rem;
    color: var(--ink-faint);
    margin-bottom: 0.25rem;
  }

  .prose {
    margin-top: 1.5rem;
    font-size: 1.0625rem;
    color: var(--ink);
  }

  .prose :global(h2) {
    font-size: 1.25rem;
    margin-top: 2rem;
  }

  .prose :global(img) {
    border-radius: var(--radius-md);
  }
</style>
