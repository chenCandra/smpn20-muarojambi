---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EventTimeline from '../components/EventTimeline.astro';
import ExtracurricularCard from '../components/ExtracurricularCard.astro';
import { events } from '../data/events';
import { extracurriculars } from '../data/extracurriculars';
import { school } from '../data/school';

const now = new Date(new Date().toDateString());
const akanDatang = events.filter((e) => new Date(e.date) >= now);
const sudahLewat = events.filter((e) => new Date(e.date) < now);
---

<BaseLayout title="Kegiatan" description={`Agenda kegiatan dan ekstrakurikuler ${school.fullName}.`}>
  <section class="bg-gradient-to-br from-secondary-light/60 to-accent-light/50 pb-16 pt-16 sm:pt-20">
    <div class="container-page reveal">
      <span class="badge bg-white text-secondary shadow-sm">Kalender & Kegiatan</span>
      <h1 class="mt-4 text-3xl sm:text-4xl">Ada Apa Hari Ini? 🎉</h1>
      <p class="mt-3 max-w-xl text-ink-soft">Agenda kegiatan dan beragam ekstrakurikuler yang bisa diikuti siswa SMPN 20 Muaro Jambi.</p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Kalender" title="Agenda Kegiatan" />
      <div class="mt-8 grid gap-10 lg:grid-cols-2">
        <div>
          <h3 class="mb-4 text-sm font-bold uppercase tracking-wide text-ink-faint">Akan Datang</h3>
          {akanDatang.length === 0 ? (
            <p class="text-sm text-ink-soft">Belum ada agenda mendatang.</p>
          ) : (
            <EventTimeline events={akanDatang} />
          )}
        </div>
        {sudahLewat.length > 0 && (
          <div class="opacity-70">
            <h3 class="mb-4 text-sm font-bold uppercase tracking-wide text-ink-faint">Sudah Berlalu</h3>
            <EventTimeline events={sudahLewat} />
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="bg-secondary-light/40 py-16 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Kegiatan Siswa" title="Temukan Minatmu ✨" subtitle="Temukan kegiatan yang membuatmu bersemangat." align="center" />
      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {extracurriculars.map((e, i) => <ExtracurricularCard name={e.name} icon={e.icon} description={e.description} delay={i * 50} />)}
      </div>
    </div>
  </section>
</BaseLayout>
