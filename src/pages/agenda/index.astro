---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';

const semuaAgenda = await getCollection('agenda');
const now = new Date();
const akanDatang = semuaAgenda.filter((a) => a.data.eventDate >= now).sort((a, b) => a.data.eventDate.valueOf() - b.data.eventDate.valueOf());
const sudahLewat = semuaAgenda.filter((a) => a.data.eventDate < now).sort((a, b) => b.data.eventDate.valueOf() - a.data.eventDate.valueOf());

const formatTanggal = (d: Date) => d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });

const rendered = await Promise.all(semuaAgenda.map((a) => render(a)));
const contentMap = new Map(semuaAgenda.map((a, i) => [a.id, rendered[i].Content]));
---

<BaseLayout title="Agenda" description="Kalender kegiatan SMP Negeri 20 Muaro Jambi.">
  <PageHeader eyebrow="🗓️ Kalender" title="Agenda Kegiatan" />

  <section class="section">
    <div class="container">
      <h2 class="group-title">Akan Datang</h2>
      {akanDatang.length === 0 ? (
        <p class="empty-note">Belum ada agenda mendatang.</p>
      ) : (
        <div class="agenda-list">
          {akanDatang.map((item) => {
            const Content = contentMap.get(item.id)!;
            return (
              <div class="card agenda-card">
                <div class="agenda-date">
                  <span class="agenda-day">{item.data.eventDate.getDate()}</span>
                  <span class="agenda-month">{item.data.eventDate.toLocaleDateString('id-ID', { month: 'short' })}</span>
                </div>
                <div class="agenda-body">
                  <h3>{item.data.title}</h3>
                  {item.data.location && <p class="agenda-meta">📍 {item.data.location}</p>}
                  {item.data.endDate && <p class="agenda-meta">Sampai {formatTanggal(item.data.endDate)}</p>}
                  <div class="prose"><Content /></div>
                </div>
              </div>
            );
          })}
        </div>
      )}

      {sudahLewat.length > 0 && (
        <>
          <h2 class="group-title group-title-past">Sudah Berlalu</h2>
          <div class="agenda-list">
            {sudahLewat.map((item) => (
              <div class="card agenda-card is-past">
                <div class="agenda-date">
                  <span class="agenda-day">{item.data.eventDate.getDate()}</span>
                  <span class="agenda-month">{item.data.eventDate.toLocaleDateString('id-ID', { month: 'short' })}</span>
                </div>
                <div class="agenda-body">
                  <h3>{item.data.title}</h3>
                  {item.data.location && <p class="agenda-meta">📍 {item.data.location}</p>}
                </div>
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .group-title {
    font-size: 1.125rem;
    margin-bottom: 1rem;
  }

  .group-title-past {
    margin-top: 2.5rem;
    color: var(--ink-faint);
  }

  .agenda-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .agenda-card {
    display: flex;
    gap: 1.25rem;
    padding: 1.25rem;
  }

  .agenda-card.is-past {
    opacity: 0.65;
  }

  .agenda-date {
    flex: 0 0 auto;
    width: 4rem;
    height: 4rem;
    border-radius: var(--radius-md);
    background: var(--primary-soft);
    color: var(--primary);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .agenda-day {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1;
  }

  .agenda-month {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .agenda-body h3 {
    font-size: 1.0625rem;
    margin: 0 0 0.25rem;
  }

  .agenda-meta {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    margin: 0 0 0.25rem;
  }

  .agenda-body .prose {
    font-size: 0.9375rem;
    color: var(--ink-soft);
    margin-top: 0.5rem;
  }

  .agenda-body .prose :global(p) {
    margin: 0;
  }

  .empty-note {
    color: var(--ink-soft);
  }
</style>
