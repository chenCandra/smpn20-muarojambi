---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProfilTabs from '../../components/ProfilTabs.astro';
---

<BaseLayout title="Sambutan Kepala Sekolah" description="Sambutan Kepala Sekolah SMP Negeri 20 Muaro Jambi.">
  <PageHeader eyebrow="🏫 Tentang Kami" title="Sambutan Kepala Sekolah" />
  <ProfilTabs />

  <section class="section">
    <div class="container prose-container">
      <!-- TODO: ganti dengan sambutan asli dari Kepala Sekolah. Ini contoh/placeholder. -->
      <p><em>Assalamu'alaikum warahmatullahi wabarakatuh,</em></p>
      <p>
        Selamat datang di situs resmi SMP Negeri 20 Muaro Jambi. Puji syukur kami panjatkan atas kepercayaan
        yang diberikan kepada kami untuk mendidik putra-putri terbaik bangsa di sekolah ini.
      </p>
      <p>
        Kami berkomitmen untuk terus meningkatkan kualitas pendidikan, membentuk karakter siswa yang berakhlak
        mulia, serta mengembangkan potensi akademik dan non-akademik setiap peserta didik. Semoga situs ini
        dapat menjadi jembatan informasi antara sekolah dengan siswa, orang tua, dan masyarakat.
      </p>
      <p>Terima kasih atas dukungan dan kerja sama yang selama ini terjalin.</p>
      <p><em>Wassalamu'alaikum warahmatullahi wabarakatuh.</em></p>

      <div class="signature">
        <strong>(Nama Kepala Sekolah)</strong>
        <span>Kepala SMP Negeri 20 Muaro Jambi</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .prose-container {
    max-width: 42rem;
  }

  .signature {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
  }

  .signature span {
    color: var(--ink-soft);
    font-size: 0.875rem;
  }
</style>
