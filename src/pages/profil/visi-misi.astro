---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProfilTabs from '../../components/ProfilTabs.astro';

const misi = [
  'Menyelenggarakan pembelajaran yang aktif, kreatif, dan menyenangkan.',
  'Membina karakter siswa melalui keteladanan dan pembiasaan.',
  'Mengembangkan bakat dan minat siswa melalui kegiatan ekstrakurikuler.',
  'Menumbuhkan semangat gotong royong dan kepedulian sosial.',
];
---

<BaseLayout title="Visi & Misi" description="Visi dan misi SMP Negeri 20 Muaro Jambi.">
  <PageHeader eyebrow="🏫 Tentang Kami" title="Visi & Misi" />
  <ProfilTabs />

  <section class="section">
    <div class="container grid grid-2 vm-grid">
      <div class="card vm-card">
        <span class="vm-emoji">🎯</span>
        <h2>Visi</h2>
        <!-- TODO: ganti dengan visi resmi sekolah. Ini contoh/placeholder. -->
        <p>Terwujudnya peserta didik yang beriman, berakhlak mulia, cerdas, dan berdaya saing di era global.</p>
      </div>
      <div class="card vm-card">
        <span class="vm-emoji">🚀</span>
        <h2>Misi</h2>
        <ol>
          <!-- TODO: ganti dengan misi resmi sekolah. Ini contoh/placeholder. -->
          {misi.map((item) => <li>{item}</li>)}
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .vm-grid {
    align-items: stretch;
  }

  .vm-card {
    padding: 1.75rem;
  }

  .vm-emoji {
    font-size: 1.75rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .vm-card h2 {
    color: var(--primary);
    font-size: 1.25rem;
  }

  .vm-card p,
  .vm-card ol {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    margin: 0;
  }

  .vm-card ol {
    padding-left: 1.1rem;
  }

  .vm-card li + li {
    margin-top: 0.4rem;
  }
</style>
