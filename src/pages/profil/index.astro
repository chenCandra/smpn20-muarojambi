---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProfilTabs from '../../components/ProfilTabs.astro';
---

<BaseLayout title="Profil Sekolah" description="Profil SMP Negeri 20 Muaro Jambi.">
  <PageHeader eyebrow="🏫 Tentang Kami" title="Profil Sekolah" />
  <ProfilTabs />

  <section class="section">
    <div class="container prose-container">
      <h2>Sekilas SMP Negeri 20 Muaro Jambi</h2>
      <p>
        <!-- TODO: lengkapi dengan sejarah singkat sekolah yang sebenarnya (tahun berdiri, lokasi lengkap, dsb). -->
        SMP Negeri 20 Muaro Jambi adalah sekolah menengah pertama negeri yang berlokasi di Kabupaten Muaro Jambi,
        Provinsi Jambi. Sekolah ini berkomitmen menyelenggarakan pendidikan yang berkualitas, membentuk karakter
        siswa yang berakhlak mulia, serta mengembangkan potensi akademik dan non-akademik setiap peserta didik.
      </p>

      <h2>Identitas Sekolah</h2>
      <!-- TODO: lengkapi data identitas resmi (NPSN, akreditasi, alamat lengkap, dst). -->
      <dl class="identity-list">
        <dt>NPSN</dt>
        <dd>(belum diisi)</dd>
        <dt>Status</dt>
        <dd>Negeri</dd>
        <dt>Alamat</dt>
        <dd>Kabupaten Muaro Jambi, Provinsi Jambi</dd>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .prose-container {
    max-width: 48rem;
  }

  .identity-list {
    display: grid;
    grid-template-columns: 10rem 1fr;
    row-gap: 0.5rem;
    margin: 1rem 0 0;
  }

  .identity-list dt {
    color: var(--ink-faint);
    font-weight: 600;
  }

  .identity-list dd {
    margin: 0;
  }
</style>
