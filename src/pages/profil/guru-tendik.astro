---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProfilTabs from '../../components/ProfilTabs.astro';
import { getCollection } from 'astro:content';

const semuaGuru = (await getCollection('guru')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Guru & Tenaga Kependidikan" description="Daftar guru dan tenaga kependidikan SMP Negeri 20 Muaro Jambi.">
  <PageHeader eyebrow="🏫 Tentang Kami" title="Guru & Tenaga Kependidikan" />
  <ProfilTabs />

  <section class="section">
    <div class="container">
      {semuaGuru.length === 0 ? (
        <p class="empty-note">Data guru & tenaga kependidikan akan segera dilengkapi.</p>
      ) : (
        <div class="grid grid-3">
          {semuaGuru.map((g) => (
            <div class="card staff-card">
              <div class="staff-avatar">{g.data.name.charAt(0)}</div>
              <strong>{g.data.name}</strong>
              <span class="staff-position">{g.data.position}</span>
              {g.data.subject && <span class="staff-subject">{g.data.subject}</span>}
            </div>
          ))}
        </div>
      )}
      <p class="note">
        <!-- edit langsung di src/content/guru.json -->
        Data di atas contoh/placeholder -- lengkapi lewat berkas <code>src/content/guru.json</code>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .staff-card {
    padding: 1.5rem;
    text-align: center;
  }

  .staff-avatar {
    width: 3.5rem;
    height: 3.5rem;
    margin: 0 auto 0.75rem;
    border-radius: 50%;
    background: var(--primary-soft);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
  }

  .staff-card strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1rem;
  }

  .staff-position {
    display: block;
    color: var(--primary);
    font-size: 0.8125rem;
    font-weight: 600;
    margin-top: 0.15rem;
  }

  .staff-subject {
    display: block;
    color: var(--ink-soft);
    font-size: 0.8125rem;
  }

  .empty-note {
    color: var(--ink-soft);
  }

  .note {
    text-align: center;
    color: var(--ink-faint);
    font-size: 0.8125rem;
    margin-top: 1.5rem;
  }
</style>
