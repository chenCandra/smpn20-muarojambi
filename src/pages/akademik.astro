---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { school } from '../data/school';

const mapel = [
  'Pendidikan Agama', 'Pendidikan Pancasila', 'Bahasa Indonesia', 'Matematika',
  'Ilmu Pengetahuan Alam', 'Ilmu Pengetahuan Sosial', 'Bahasa Inggris', 'Seni Budaya',
  'PJOK', 'Prakarya/Informatika',
];

const jadwalPenting = [
  { title: 'Penilaian Tengah Semester', period: '[Tanggal]' },
  { title: 'Penilaian Akhir Semester', period: '[Tanggal]' },
  { title: 'Pembagian Rapor', period: '[Tanggal]' },
];
---

<BaseLayout title="Akademik" description={`Kurikulum dan informasi akademik ${school.fullName}.`}>
  <section class="bg-gradient-to-br from-primary-light/70 to-secondary-light/60 pb-16 pt-16 sm:pt-20">
    <div class="container-page reveal">
      <span class="badge bg-white text-primary-dark shadow-sm">Kurikulum</span>
      <h1 class="mt-4 text-3xl sm:text-4xl">Akademik</h1>
      <p class="mt-3 max-w-xl text-ink-soft">Kurikulum Merdeka -- pembelajaran yang berpusat pada peserta didik, mendorong minat dan potensi setiap siswa.</p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page grid gap-12 lg:grid-cols-2">
      <div class="reveal">
        <SectionHeading eyebrow="Pembelajaran" title="Kurikulum Merdeka" />
        <p class="mt-4 text-sm text-ink-soft">
          <!-- TODO: sesuaikan dengan penerapan kurikulum yang sebenarnya di sekolah. -->
          Pembelajaran diselenggarakan dengan pendekatan Kurikulum Merdeka, memberikan ruang bagi siswa untuk
          belajar dan berkembang sesuai minat, potensi, dan kebutuhan belajarnya masing-masing.
        </p>
        <h2 class="mt-6 text-lg">Mata Pelajaran</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {mapel.map((m) => (
            <span class="rounded-full border border-border bg-white px-3.5 py-1.5 text-xs font-semibold text-ink-soft">{m}</span>
          ))}
        </div>
      </div>

      <div class="reveal [animation-delay:100ms]">
        <SectionHeading eyebrow="Kalender" title="Jadwal Penting" />
        <ul class="mt-4 space-y-3">
          {jadwalPenting.map((j) => (
            <li class="card flex items-center gap-3 p-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary-light text-primary-dark">
                <Icon name="calendar" class="h-5 w-5" />
              </div>
              <div>
                <p class="text-sm font-bold">{j.title}</p>
                <p class="text-xs text-ink-faint">{j.period}</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-ink-faint">Jadwal di atas placeholder -- lengkapi begitu kalender akademik resmi tersedia.</p>
      </div>
    </div>
  </section>
</BaseLayout>
