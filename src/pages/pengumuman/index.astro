---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const semuaPengumuman = await getCollection('pengumuman', ({ data }) => !data.draft);
const now = new Date();

// Yang masih berlaku (belum lewat validUntil, atau tidak punya batas
// tanggal sama sekali) tampil dulu -- disematkan (pinned) di atas semua,
// baru diurutkan terbaru. Yang sudah lewat validUntil-nya otomatis nggak
// ikut tampil lagi -- sama pola kayak modul Pengumuman di LARAS (nggak
// perlu dihapus manual begitu kedaluwarsa).
const aktif = semuaPengumuman
  .filter((p) => !p.data.validUntil || p.data.validUntil >= now)
  .sort((a, b) => {
    if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  });

const formatTanggal = (d: Date) => d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Pengumuman" description="Pengumuman resmi SMP Negeri 20 Muaro Jambi.">
  <PageHeader eyebrow="📢 Informasi" title="Pengumuman" />

  <section class="section">
    <div class="container">
      {aktif.length === 0 ? (
        <p class="empty-note">Belum ada pengumuman yang berlaku saat ini.</p>
      ) : (
        <div class="pengumuman-list">
          {aktif.map((item) => (
            <a href={`/pengumuman/${item.id}`} class:list={['card pengumuman-card', { 'is-pinned': item.data.pinned }]}>
              {item.data.pinned && <span class="pin-badge">📌 Disematkan</span>}
              <span class="pengumuman-date">{formatTanggal(item.data.pubDate)}</span>
              <h2>{item.data.title}</h2>
              {item.data.excerpt && <p>{item.data.excerpt}</p>}
              {item.data.validUntil && <span class="valid-until">Berlaku sampai {formatTanggal(item.data.validUntil)}</span>}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .pengumuman-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 42rem;
  }

  .pengumuman-card {
    display: block;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    color: var(--ink);
  }

  .pengumuman-card.is-pinned {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .pin-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  .pengumuman-date {
    font-size: 0.8125rem;
    color: var(--ink-faint);
  }

  .pengumuman-card h2 {
    font-size: 1.0625rem;
    margin: 0.3rem 0 0.3rem;
  }

  .pengumuman-card p {
    font-size: 0.9375rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .valid-until {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--ink-faint);
  }

  .empty-note {
    color: var(--ink-soft);
  }
</style>
