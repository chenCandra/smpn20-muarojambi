---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import { requireAuth } from '../../../lib/require-auth';
import { createStat, deleteStat, getStats, updateStat } from '../../../lib/stats';
import { env } from '../../../lib/env';

const auth = await requireAuth(Astro);
if (auth instanceof Response) return auth;
const user = auth;

const db = env.DB;
let error: string | null = null;

// Halaman settings kecil (cuma segelintir baris) -- semua aksi (ubah/tambah/
// hapus) ditangani di satu halaman ini lewat form terpisah per baris,
// dibedakan field `_action`, sama polanya kayak delete di /admin/posts.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');

  if (action === 'delete') {
    const id = Number(form.get('id'));
    if (id) await deleteStat(db, id);
    return Astro.redirect('/admin/stats');
  }

  if (action === 'update' || action === 'create') {
    const label = String(form.get('label') ?? '').trim();
    const value = Number(form.get('value'));
    const suffix = String(form.get('suffix') ?? '').trim();
    const sortOrder = Number(form.get('sort_order') ?? 0);

    if (!label || Number.isNaN(value)) {
      error = 'Label wajib diisi dan Angka harus berupa nomor.';
    } else if (action === 'update') {
      const id = Number(form.get('id'));
      await updateStat(db, id, { label, value, suffix, sort_order: sortOrder });
      return Astro.redirect('/admin/stats');
    } else {
      await createStat(db, { label, value, suffix, sort_order: sortOrder });
      return Astro.redirect('/admin/stats');
    }
  }
}

const stats = await getStats(db);
---

<AdminLayout title="Statistik" user={user}>
  <h1 class="text-2xl font-extrabold">Statistik</h1>
  <p class="text-sm text-ink-soft">Kartu angka yang tampil di beranda (jumlah siswa, guru, dst). Urutan tampil ditentukan kolom "Urutan" (kecil dulu).</p>

  {error && <div class="mt-4 max-w-2xl rounded-xl bg-accent2-light px-4 py-2.5 text-sm font-semibold text-accent2-dark">{error}</div>}

  <div class="mt-6 overflow-hidden rounded-2xl border border-border bg-white">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-border bg-bg text-xs font-bold uppercase tracking-wide text-ink-faint">
        <tr>
          <th class="px-4 py-3">Label</th>
          <th class="px-4 py-3">Angka</th>
          <th class="px-4 py-3">Sufiks</th>
          <th class="px-4 py-3">Urutan</th>
          <th class="px-4 py-3 text-right">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        {stats.length === 0 ? (
          <tr><td colspan="5" class="px-4 py-10 text-center text-ink-faint">Belum ada statistik. Tambah lewat form di bawah.</td></tr>
        ) : (
          stats.map((s) => (
            <tr>
              <td colspan="5" class="p-0">
                <div class="flex flex-wrap items-center gap-2 px-4 py-2.5">
                  <form method="POST" class="flex flex-1 flex-wrap items-center gap-2">
                    <input type="hidden" name="_action" value="update" />
                    <input type="hidden" name="id" value={s.id} />
                    <input
                      name="label"
                      value={s.label}
                      required
                      class="min-w-[10rem] flex-1 rounded-lg border border-border px-3 py-1.5 text-sm outline-none focus:border-secondary"
                    />
                    <input
                      name="value"
                      type="number"
                      value={s.value}
                      required
                      class="w-24 rounded-lg border border-border px-3 py-1.5 text-sm outline-none focus:border-secondary"
                    />
                    <input
                      name="suffix"
                      value={s.suffix}
                      placeholder="mis. +"
                      class="w-20 rounded-lg border border-border px-3 py-1.5 text-sm outline-none focus:border-secondary"
                    />
                    <input
                      name="sort_order"
                      type="number"
                      value={s.sort_order}
                      class="w-20 rounded-lg border border-border px-3 py-1.5 text-sm outline-none focus:border-secondary"
                    />
                    <button type="submit" class="rounded-lg px-3 py-1.5 text-sm font-semibold text-secondary hover:bg-bg">Simpan</button>
                  </form>
                  <form method="POST" onsubmit="return confirm('Hapus statistik ini?');">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="id" value={s.id} />
                    <button type="submit" class="rounded-lg p-1.5 text-ink-soft hover:bg-accent2-light hover:text-accent2-dark" title="Hapus">
                      <Icon name="x" class="h-4 w-4" />
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>

  <div class="mt-6 max-w-2xl rounded-2xl border border-border bg-white p-5">
    <h2 class="text-sm font-bold">Tambah Statistik Baru</h2>
    <form method="POST" class="mt-3 flex flex-wrap items-end gap-2">
      <input type="hidden" name="_action" value="create" />
      <div class="flex-1 min-w-[10rem]">
        <label class="text-xs font-semibold text-ink-faint">Label</label>
        <input name="label" required placeholder="mis. Prestasi Nasional" class="mt-1 w-full rounded-lg border border-border px-3 py-1.5 text-sm outline-none focus:border-secondary" />
      </div>
      <div>
        <label class="text-xs font-semibold text-ink-faint">Angka</label>
        <input name="value" type="number" required class="mt-1 w-24 rounded-lg border border-border px-3 py-1.5 text-sm outline-none focus:border-secondary" />
      </div>
      <div>
        <label class="text-xs font-semibold text-ink-faint">Sufiks</label>
        <input name="suffix" placeholder="mis. +" class="mt-1 w-20 rounded-lg border border-border px-3 py-1.5 text-sm outline-none focus:border-secondary" />
      </div>
      <div>
        <label class="text-xs font-semibold text-ink-faint">Urutan</label>
        <input name="sort_order" type="number" value={stats.length} class="mt-1 w-20 rounded-lg border border-border px-3 py-1.5 text-sm outline-none focus:border-secondary" />
      </div>
      <button type="submit" class="btn-primary">Tambah</button>
    </form>
  </div>
</AdminLayout>
