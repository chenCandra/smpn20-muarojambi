---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import { requireAuth } from '../../../lib/require-auth';
import { deleteGalleryPhoto, getGalleryPhotos } from '../../../lib/gallery';
import { env } from '../../../lib/env';

const auth = await requireAuth(Astro);
if (auth instanceof Response) return auth;
const user = auth;

const db = env.DB;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('_action') === 'delete') {
    const id = Number(form.get('id'));
    if (id) await deleteGalleryPhoto(db, id);
    return Astro.redirect('/admin/gallery');
  }
}

const photos = await getGalleryPhotos(db);
---

<AdminLayout title="Galeri" user={user}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-extrabold">Galeri Foto</h1>
      <p class="text-sm text-ink-soft">Tampil di galeri beranda ("Moments at SMPN 20") & galeri bergantian di Hero.</p>
    </div>
    <a href="/admin/gallery/new" class="btn-primary">
      <Icon name="sparkle" class="h-4 w-4" />
      Tambah
    </a>
  </div>

  <div class="mt-6 overflow-hidden rounded-2xl border border-border bg-white">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-border bg-bg text-xs font-bold uppercase tracking-wide text-ink-faint">
        <tr>
          <th class="px-4 py-3">Foto</th>
          <th class="px-4 py-3">Keterangan</th>
          <th class="px-4 py-3">Orientasi</th>
          <th class="px-4 py-3">Urutan</th>
          <th class="px-4 py-3 text-right">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        {photos.length === 0 ? (
          <tr><td colspan="5" class="px-4 py-10 text-center text-ink-faint">Belum ada foto galeri. Klik "Tambah" untuk mulai.</td></tr>
        ) : (
          photos.map((p) => (
            <tr>
              <td class="px-4 py-3">
                <div class="flex h-12 w-16 items-center justify-center overflow-hidden rounded-lg bg-secondary-light/40 text-secondary">
                  {p.src ? <img src={p.src} alt={p.alt} class="h-full w-full object-cover" /> : <Icon name="file" class="h-5 w-5" />}
                </div>
              </td>
              <td class="px-4 py-3 font-semibold">{p.caption || <span class="font-normal text-ink-faint">-</span>}</td>
              <td class="px-4 py-3 text-ink-soft">{p.size}</td>
              <td class="px-4 py-3 text-ink-soft">{p.sort_order}</td>
              <td class="px-4 py-3">
                <div class="flex justify-end gap-2">
                  <a href={`/admin/gallery/${p.id}/edit`} class="rounded-lg p-2 text-ink-soft hover:bg-bg hover:text-secondary" title="Edit">
                    <Icon name="file" class="h-4 w-4" />
                  </a>
                  <form method="POST" onsubmit="return confirm('Hapus foto ini? Tindakan ini tidak bisa dibatalkan.');">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="id" value={p.id} />
                    <button type="submit" class="rounded-lg p-2 text-ink-soft hover:bg-accent2-light hover:text-accent2-dark" title="Hapus">
                      <Icon name="x" class="h-4 w-4" />
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
