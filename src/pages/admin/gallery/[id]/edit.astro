---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import GalleryForm from '../../../../components/admin/GalleryForm.astro';
import { requireAuth } from '../../../../lib/require-auth';
import { getGalleryPhotoById, updateGalleryPhoto, type GalleryPhotoSize } from '../../../../lib/gallery';
import { env } from '../../../../lib/env';

const auth = await requireAuth(Astro);
if (auth instanceof Response) return auth;
const user = auth;

const db = env.DB;
const id = Number(Astro.params.id);

let photo = await getGalleryPhotoById(db, id);
if (!photo) {
  return Astro.redirect('/admin/gallery');
}

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const src = String(form.get('src') ?? '').trim();
  const alt = String(form.get('alt') ?? '').trim();

  if (!src || !alt) {
    error = 'URL Foto dan Teks Alternatif wajib diisi.';
  } else {
    await updateGalleryPhoto(db, id, {
      src,
      alt,
      caption: String(form.get('caption') ?? '').trim() || null,
      size: String(form.get('size') ?? 'landscape') as GalleryPhotoSize,
      sort_order: Number(form.get('sort_order') ?? 0),
    });
    return Astro.redirect('/admin/gallery');
  }
}
---

<AdminLayout title="Edit Foto" user={user}>
  <a href="/admin/gallery" class="text-sm font-semibold text-ink-soft hover:text-secondary">&larr; Galeri</a>
  <h1 class="mt-2 text-2xl font-extrabold">Edit Foto</h1>

  <GalleryForm photo={photo} action={`/admin/gallery/${id}/edit`} error={error} nextSortOrder={photo.sort_order} />
</AdminLayout>
